# Copy to .env and adjust as needed. All values have sane defaults in config.py.

DATA_PATH=Data/
DB_FAISS_PATH=vectorstore/db_faiss
DB_BM25_PATH=vectorstore/bm25.pkl
VECTORSTORE_ROOT=vectorstore/sessions
SESSIONS_DB_PATH=sessions.db

# Served via fastembed (ONNX runtime), not sentence-transformers/torch.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Path to a local GGUF model, e.g. downloaded from:
# https://huggingface.co/meta-llama or https://huggingface.co/TheBloke (GGUF repos)
MODEL_PATH=models/llama-3-8b-instruct.Q4_K_M.gguf
LLM_CONTEXT_WINDOW=4096
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.3
# Number of layers to offload to GPU (0 = CPU only)
LLM_GPU_LAYERS=0
# Discourages the model from looping/repeating itself. 1.0 = off; 1.1-1.3 is a
# reasonable range for smaller/weaker models that tend to ramble past the answer.
LLM_REPEAT_PENALTY=1.15
# Only needed if your GGUF file doesn't embed its own chat template.
# e.g. chatml | llama-3 | mistral-instruct -- leave blank to auto-detect.
LLM_CHAT_FORMAT=

CHUNK_SIZE=800
CHUNK_OVERLAP=120

# heuristic | llm | off
CONTEXTUAL_HEADERS=heuristic

# Per-file upload size cap.
MAX_UPLOAD_MB=50

DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
RERANK_TOP_N=4
